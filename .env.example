# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > API Keys
#
# ATENÇÃO: a chave service_role (secret) dá acesso total ao banco.
# Ela fica só aqui, no seu computador. Nunca coloque no site nem envie para o GitHub.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role
